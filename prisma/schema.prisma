// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid()) @map("_id")
  username String @unique
  email String @unique
  password String
  profileImage UserProfileImage?  
  verificationToken String?
  verificationTokenExpires DateTime?
  verified Boolean @default(false)
  charCreated Character[]
  chats Chat[]
  comments Comment[]
  personaUsed String?
  personas UserPersona[]
  userSettings UserSettings?
  lorebooks Lorebook[]
}

model UserSettings {
  id String @id @default(cuid()) @map("_id")
  user User @relation(fields: [userId], references: [id])
  userId String @unique
  chatSettings Json?
  showNsfw Boolean @default(false)
  blurNsfw Boolean @default(true)
}

model UserPersona {
  id String @id @default(cuid()) @map("_id")
  name String
  person String
  user User @relation(fields: [userId], references: [id])
  userId String 
}

model UserProfileImage {
  id String @id @default(cuid()) @map("_id")
  mimetype String
  data Bytes
  user User @relation(fields: [userId], references: [id])
  userId String @unique
}

model Character {
  id String @id @default(cuid()) @map("_id")
  name String 
  persona String 
  bio String
  scenario String
  introMessage String
  exampleConversations String?
  isNsfw Boolean @default(false)
  author User @relation(fields: [authorId], references: [id])
  authorId String
  chats Chat[]
  photo CharacterImage?
  tags CharacterTag[] @relation(fields: [tagIds], references: [id])
  tagIds String[] 
  comments Comment[]
  lorebookIds String[]
  lorebooks Lorebook[] @relation(fields: [lorebookIds], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lorebook {
  id String @id @default(cuid()) @map("_id")
  name String
  description String?
  userId String
  user User @relation(fields: [userId], references: [id])
  entries LoreEntry[]
  characterIds String[]
  characters Character[] @relation(fields: [characterIds], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoreEntry {
  id String @id @default(cuid()) @map("_id")
  lorebookId String
  lorebook Lorebook @relation(fields: [lorebookId], references: [id], onDelete: Cascade)
  keywords String[] // Triggers for this entry
  content String // Information to inject
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Comment {
  id String @id @default(cuid()) @map("_id")
  content String 
  author User @relation(fields: [authorId], references: [id])
  authorId String
  character Character @relation(fields: [characterId], references: [id])
  characterId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CharacterTag {
  id String @id @default(cuid()) @map("_id")
  name String @unique
  charIds String[]
  chars Character[] @relation(fields: [charIds], references: [id])
}

model CharacterImage {
  id String @id @default(cuid()) @map("_id")
  data Bytes
  name String 
  mimetype String
  char Character? @relation(fields: [charId], references: [id])
  charId String @unique
}

model Chat {
  id String @id @default(cuid()) @map("_id")
  character Character @relation(fields: [characterId], references: [id]) 
  characterId String
  user User @relation(fields: [userId], references: [id])
  userId String
  messages Message[]
  summary String?
  memory String?
  personaId String?
  chatSettings Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id String @id @default(cuid()) @map("_id")
  content String 
  fromUser Boolean
  pinned Boolean @default(false)
  chat Chat @relation(fields: [chatId], references: [id])
  chatId String 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

