generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String            @id @default(cuid())
  username                 String            @unique
  email                    String            @unique
  password                 String
  verificationToken        String?
  verificationTokenExpires DateTime?
  verified                 Boolean           @default(false)
  personaUsed              String?
  isAdmin                  Boolean           @default(false)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @default(now()) @updatedAt
  charCreated              Character[]
  chats                    Chat[]
  comments                 Comment[]
  lorebooks                Lorebook[]
  personas                 UserPersona[]
  profileImage             UserProfileImage?
  userSettings             UserSettings?
}

model UserSettings {
  id           String  @id @default(cuid())
  userId       String  @unique
  chatSettings Json?
  showNsfw     Boolean @default(false)
  blurNsfw     Boolean @default(true)
  user         User    @relation(fields: [userId], references: [id])
}

model UserPersona {
  id     String        @id @default(cuid())
  name   String
  person String
  userId String
  image  PersonaImage?
  user   User          @relation(fields: [userId], references: [id])
}

model PersonaImage {
  id        String      @id @default(cuid())
  data      Bytes
  name      String
  mimetype  String
  personaId String      @unique
  persona   UserPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)
}

model UserProfileImage {
  id       String @id @default(cuid())
  mimetype String
  data     Bytes
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
}

model Character {
  id                   String          @id @default(cuid())
  name                 String
  chubId               String?         @unique
  persona              String
  bio                  String
  scenario             String
  introMessage         String
  exampleConversations String?
  isNsfw               Boolean         @default(false)
  authorId             String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  author               User            @relation(fields: [authorId], references: [id])
  photo                CharacterImage?
  chats                Chat[]
  comments             Comment[]
  tags                 CharacterTag[]  @relation("CharacterToCharacterTag")
  lorebooks            Lorebook[]      @relation("CharacterToLorebook")
}

model Lorebook {
  id                String         @id @default(cuid())
  name              String
  description       String?
  userId            String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  chubId            String?        @unique
  recursiveScanning Boolean        @default(false)
  scanDepth         Int            @default(4)
  tokenBudget       Int            @default(512)
  entries           LoreEntry[]
  user              User           @relation(fields: [userId], references: [id])
  image             LorebookImage?
  characters        Character[]    @relation("CharacterToLorebook")
  tags              LorebookTag[]  @relation("LorebookToLorebookTag")
}

model LorebookImage {
  id         String   @id @default(cuid())
  lorebookId String   @unique
  name       String
  mimetype   String
  data       Bytes
  createdAt  DateTime @default(now())
  lorebook   Lorebook @relation(fields: [lorebookId], references: [id], onDelete: Cascade)
}

model LorebookTag {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  lorebooks Lorebook[] @relation("LorebookToLorebookTag")
}

model LoreEntry {
  id         String   @id @default(cuid())
  lorebookId String
  keywords   String[]
  content    String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lorebook   Lorebook @relation(fields: [lorebookId], references: [id], onDelete: Cascade)
}

model Comment {
  id          String    @id @default(cuid())
  content     String
  authorId    String
  characterId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User      @relation(fields: [authorId], references: [id])
  character   Character @relation(fields: [characterId], references: [id])
}

model CharacterTag {
  id    String      @id @default(cuid())
  name  String      @unique
  chars Character[] @relation("CharacterToCharacterTag")
}

model CharacterImage {
  id       String    @id @default(cuid())
  data     Bytes
  name     String
  mimetype String
  charId   String    @unique
  char     Character @relation(fields: [charId], references: [id])
}

model Chat {
  id           String    @id @default(cuid())
  characterId  String
  userId       String
  summary      String?
  memory       String?
  personaId    String?
  chatSettings Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  character    Character @relation(fields: [characterId], references: [id])
  user         User      @relation(fields: [userId], references: [id])
  messages     Message[]
}

model Message {
  id              String   @id @default(cuid())
  content         String
  fromUser        Boolean
  pinned          Boolean  @default(false)
  chatId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  feedback        Feedback @default(NONE)
  originalContent String?
  chat            Chat     @relation(fields: [chatId], references: [id])
}

model SystemSetting {
  key   String @id
  value String
}

enum Feedback {
  NONE
  LIKE
  DISLIKE
}
